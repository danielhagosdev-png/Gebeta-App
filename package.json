{
  "name": "gebeta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:mobile": "vite build --config vite.mobile.config.ts && node scripts/embed-mobile-html.mjs",
    "start": "npm run build:mobile && expo start",
    "start:tunnel": "npm run build:mobile && expo start --tunnel",
    "android": "npm run build:mobile && expo start --android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@tailwindcss/vite": "^4.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "expo": "^58.1.0",
    "expo-dev-client": "~58.0.22",
    "expo-haptics": "^58.0.8",
    "expo-status-bar": "^58.0.5",
    "expo-store-review": "^58.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-webview": "^14.0.1",
    "three": "^0.170.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "main": "index.ts"
}
